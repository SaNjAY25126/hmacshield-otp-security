# Copy this file to .env. Never commit your real credentials.
# APP_MODE=demo enables localhost-only attack simulations. Use production when deployed.
APP_MODE=demo
FLASK_SECRET_KEY=replace-with-a-long-random-secret-at-least-32-characters
ADMIN_USERNAME=replace-with-admin-name
ADMIN_PASSWORD_HASH=replace-with-generated-werkzeug-password-hash
# Free real-email delivery (Gmail example). Create a Google App Password; never use your normal password.
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=youraddress@gmail.com
SMTP_APP_PASSWORD=your_16_character_google_app_password
EMAIL_FROM=youraddress@gmail.com
OTP_MASTER_SECRET=replace-with-a-long-random-secret-at-least-32-characters
# Optional persistent database path. On hosting, point this into a persistent disk mount.
# DATABASE_PATH=/var/data/users.sqlite3
